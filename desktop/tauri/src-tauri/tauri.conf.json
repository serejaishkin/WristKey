{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "WristKey",
  "identifier": "com.wristkey.app",
  "build": {
    "beforeBuildCommand": "cmd /C src-tauri\\build-cp.cmd",
    "beforeDevCommand": "",
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WristKey",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "WristKey",
    "targets": ["msi", "nsis"],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "wix": null
    },
    "resources": [
      "../../crates/credential-provider/bin/Release/net48/WristKeyCredentialProvider.dll",
      "../../crates/credential-provider/bin/Release/net48/Newtonsoft.Json.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}

